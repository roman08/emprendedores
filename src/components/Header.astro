---
import Logo from './Logo.astro';
import { BRAND } from '../lib/brand';
---
<header class="sticky top-0 z-30 border-b border-line bg-white/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4">
    <a href="/" class="inline-flex min-h-11 items-center rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600" aria-label={`${BRAND.name}, inicio`}>
      <Logo compactOnMobile />
    </a>
    <form action="/explorar" class="ml-4 hidden max-w-md flex-1 md:block">
      <input name="q" class="input !rounded-full" placeholder="Buscar productos o servicios…" aria-label="Buscar" />
    </form>
    <nav aria-label="Principal" class="ml-auto flex items-center gap-2 whitespace-nowrap">
      <a href="/explorar" class="btn btn-ghost hidden sm:inline-flex">Explorar</a>
      <!-- En móvil el header no da espacio para tres botones: allí "Cerca de mí" va en el pie y en la portada -->
      <a href="/cerca" class="btn btn-ghost hidden sm:inline-flex">Cerca de mí</a>
      <!-- Guardados: en móvil solo icono + contador (se actualiza con lib/favoritesUi) -->
      <a href="/favoritos" data-fav-link aria-label="Guardados" class="btn btn-ghost !px-3">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21.2l7.8-7.7 1-1.1a5.5 5.5 0 0 0 0-7.8z" /></svg>
        <span class="hidden lg:inline">Guardados</span>
        <span data-fav-count hidden class="min-w-5 rounded-full bg-rose-600 px-1.5 text-center text-xs font-bold leading-5 text-white" aria-hidden="true"></span>
      </a>
      <!-- Visitante -->
      <a data-guest href="/ingresar" class="btn btn-ghost">Ingresar</a>
      <a data-guest href="/registro" class="btn btn-primary">Publica gratis</a>
      <!-- Con sesión -->
      <a data-user href="/panel" class="btn btn-primary">Mi panel</a>
      <button data-user data-logout type="button" class="btn btn-ghost">Salir</button>
    </nav>
  </div>
</header>
<script>import '../lib/favoritesUi';</script>
