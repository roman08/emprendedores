---
import Logo from './Logo.astro';
import { BRAND } from '../lib/brand';
---
<footer class="mt-16 border-t border-line bg-white">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col gap-2">
      <Logo size={24} />
      <p>© {new Date().getFullYear()} {BRAND.name} · Hecho en Tabasco para todo México.</p>
    </div>
    <nav aria-label="Pie de página" class="flex flex-wrap gap-x-5 gap-y-2">
      <a href="/cerca" class="hover:text-ink">Cerca de mí</a>
      <a href="/favoritos" data-fav-link class="hover:text-ink">Guardados <span data-fav-count hidden class="ml-0.5 rounded-full bg-rose-600 px-1.5 text-xs font-bold text-white"></span></a>
      <a href="/como-funciona" class="hover:text-ink">Cómo funciona</a>
      <a href="/guia" class="hover:text-ink">Guía para emprendedores</a>
      <a href="/terminos" class="hover:text-ink">Términos</a>
      <a href="/privacidad" class="hover:text-ink">Privacidad</a>
      <a href="/contacto" class="hover:text-ink">Contacto</a>
      <a href="/instalar" class="hover:text-ink">Instalar la app</a>
      <button type="button" data-cookie-prefs hidden class="hover:text-ink">Preferencias de cookies</button>
      <a data-cta href="/registro" class="hover:text-ink">Publica tu negocio</a>
    </nav>
  </div>
  <nav aria-label="Municipios" class="mx-auto max-w-6xl border-t border-line px-4 py-4 text-sm text-muted">
    <span class="block whitespace-nowrap font-medium text-ink sm:inline">Negocios en:</span>
    {[['Cunduacán', 'cunduacan'], ['Villahermosa', 'villahermosa'], ['Comalcalco', 'comalcalco'], ['Jalpa de Méndez', 'jalpa-de-mendez'], ['Nacajuca', 'nacajuca'], ['Paraíso', 'paraiso']].map(([n, s]) => (
      <a href={`/tabasco/${s}`} class="mr-3 inline-block py-1.5 hover:text-ink sm:ml-3 sm:mr-0">{n}</a>
    ))}
  </nav>
</footer>
