---
import { formatPrice } from '../lib/format';
interface Props { l: any }
const { l } = Astro.props;
const img = [...(l.listing_images ?? [])].sort((a: any, b: any) => a.position - b.position)[0]?.url;
const place = l.businesses?.municipalities?.name;
const soldOut = l.availability === 'sold_out';
const onDemand = l.availability === 'on_demand';
// Distancia solo cuando /explorar ordena por cercanía. Sin pin del local es aproximada (centro del municipio).
const km = typeof l.distance_km === 'number' ? l.distance_km : null;
const distance = km === null ? '' : `${l.distance_exact ? '' : '≈ '}${km < 1 ? Math.max(10, Math.round((km * 1000) / 10) * 10) + ' m' : km.toFixed(1) + ' km'}`;
---
<div class="group relative h-full motion-safe:transition motion-safe:hover:-translate-y-0.5">
<a href={`/p/${l.slug}`} class="card block h-full overflow-hidden transition group-hover:shadow-md">
  <div class="relative aspect-[4/3] overflow-hidden bg-surface">
    {img && <img src={img} alt={l.title} loading="lazy" class:list={['h-full w-full object-cover transition duration-300 group-hover:scale-105', soldOut && 'opacity-50 grayscale']} />}
    {soldOut && <span class="absolute left-2 top-2 rounded-full bg-gray-900/80 px-2.5 py-1 text-xs font-semibold text-white">Agotado</span>}
    {onDemand && <span class="absolute left-2 top-2 rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-800">Sobre pedido</span>}
  </div>
  <div class="p-4">
    <p class="line-clamp-2 font-semibold leading-snug">{l.title}</p>
    <p class="mt-1 text-lg font-bold text-brand-700">{formatPrice(l.price)}</p>
    <p class="mt-2 truncate text-xs text-muted">
      {l.businesses?.name}{place ? ` · ${place}` : ''}
      {l.type === 'service' && <span class="ml-1 rounded-full bg-brand-50 px-2 py-0.5 text-brand-700">Servicio</span>}
    </p>
    {distance && <p class="mt-1 text-xs font-semibold text-brand-700">A {distance} de ti</p>}
  </div>
</a>
{/* Corazón fuera del enlace (HTML válido); un único script delegado (lib/favoritesUi) lo activa */}
{l.id && (
  <button type="button" data-fav-id={l.id} data-fav-kind="listing" aria-pressed="false" aria-label="Guardar en favoritos"
    class="absolute right-1 top-1 grid h-11 w-11 place-items-center rounded-full text-gray-700 focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-brand-600 [&[aria-pressed=true]_svg]:fill-rose-600 [&[aria-pressed=true]_svg]:stroke-rose-600">
    <span class="grid h-8 w-8 place-items-center rounded-full bg-white/90 shadow-sm motion-safe:transition motion-safe:active:scale-90">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21.2l7.8-7.7 1-1.1a5.5 5.5 0 0 0 0-7.8z" /></svg>
    </span>
  </button>
)}
</div>
