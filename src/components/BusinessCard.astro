---
// Tarjeta de NEGOCIO (no de publicación): lleva la etiqueta «Negocio» y enlaza a /n/<slug>.
// Recibe filas de lib/businesses (con published_count y, al ordenar por cercanía, distance_km).
import { initials, cssUrl, safeHttpUrl } from '../lib/format';
import { parseHours, openStatus } from '../lib/hours';
import VerifiedBadge from './VerifiedBadge.astro';
interface Props { b: any }
const { b } = Astro.props;
const place = b.municipalities?.name;
const cover = cssUrl(b.banner_url);
const logo = safeHttpUrl(b.logo_url);
const status = openStatus(parseHours(b.hours));
const pubs = Number(b.published_count ?? 0);
const km = typeof b.distance_km === 'number' ? b.distance_km : null;
const distance = km === null ? '' : `${b.distance_exact ? '' : '≈ '}${km < 1 ? Math.max(10, Math.round((km * 1000) / 10) * 10) + ' m' : km.toFixed(1) + ' km'}`;
---
<div class="group relative h-full motion-safe:transition motion-safe:hover:-translate-y-0.5">
<a href={`/n/${b.slug}`} class="card block h-full overflow-hidden transition group-hover:shadow-md">
  <div class="relative grid aspect-[4/3] place-items-center overflow-hidden bg-gradient-to-br from-brand-50 to-brand-100 bg-cover bg-center" style={cover ? `background-image:${cover}` : undefined}>
    {logo ? (
      <img src={logo} alt="" width="96" height="96" loading="lazy" decoding="async" class="h-20 w-20 rounded-full border-4 border-white bg-white object-cover shadow-sm sm:h-24 sm:w-24" />
    ) : (
      <span aria-hidden="true" class="grid h-20 w-20 place-items-center rounded-full border-4 border-white bg-brand-600 text-2xl font-bold text-white shadow-sm sm:h-24 sm:w-24">{initials(b.name)}</span>
    )}
    <span class="absolute bottom-2 left-2 inline-flex items-center gap-1 rounded-full bg-brand-700 px-2.5 py-1 text-xs font-semibold text-white shadow-sm">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9 4.5 4h15L21 9M3 9v11h18V9M3 9h18M9 20v-6h6v6" /></svg>
      Negocio
    </span>
  </div>
  <div class="p-4">
    <p class="flex items-start gap-1 font-semibold leading-snug"><span class="line-clamp-2">{b.name}</span>{b.verified && <VerifiedBadge size={18} />}</p>
    <p class="mt-1 text-sm text-muted">{pubs === 0 ? 'Aún sin publicaciones' : pubs === 1 ? '1 publicación' : `${pubs} publicaciones`}</p>
    <p class="mt-2 truncate text-xs text-muted">{place ?? ''}{place && b.has_physical_store ? ' · ' : ''}{b.has_physical_store ? 'Con local' : ''}</p>
    {status && (
      <p class:list={['mt-1 inline-flex items-center gap-1 text-xs font-semibold', status.open ? 'text-brand-700' : 'text-muted']}>
        <span class:list={['h-1.5 w-1.5 rounded-full', status.open ? 'bg-brand-500' : 'bg-gray-400']}></span>{status.open ? 'Abierto' : 'Cerrado'}
      </p>
    )}
    {distance && <p class="mt-1 text-xs font-semibold text-brand-700">A {distance} de ti</p>}
  </div>
</a>
<button type="button" data-fav-id={b.id} data-fav-kind="business" aria-pressed="false" aria-label="Guardar en favoritos"
  class="absolute right-1 top-1 grid h-11 w-11 place-items-center rounded-full text-gray-700 focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-brand-600 [&[aria-pressed=true]_svg]:fill-rose-600 [&[aria-pressed=true]_svg]:stroke-rose-600">
  <span class="grid h-8 w-8 place-items-center rounded-full bg-white/90 shadow-sm motion-safe:transition motion-safe:active:scale-90">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21.2l7.8-7.7 1-1.1a5.5 5.5 0 0 0 0-7.8z" /></svg>
  </span>
</button>
</div>
