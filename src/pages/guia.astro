---
import Base from '../layouts/Base.astro';

const pasos = [
  {
    icon: '📱',
    title: 'Crea tu cuenta',
    body: [
      'Entra a "Publicar mi negocio" y escribe tu correo y una contraseña.',
      'Si te pedimos confirmar el correo, abre el mensaje que te llegó y pulsa el enlace. Revisa también la carpeta de spam.',
    ],
  },
  {
    icon: '🏪',
    title: 'Crea tu negocio',
    body: [
      'Escribe el nombre de tu negocio, el municipio y una descripción corta de lo que haces.',
      'Pon tu número de WhatsApp con lada (10 dígitos). Ahí te van a escribir tus clientes.',
      'Si tienes local, marca "local físico" y coloca el pin en el mapa para que te encuentren en "Cerca de mí".',
      'Agrega tus horarios. Si no los llenas, no pasa nada: puedes hacerlo después.',
    ],
  },
  {
    icon: '📸',
    title: 'Sube tu primer producto',
    body: [
      'Desde el panel pulsa "Nueva publicación". Escribe un nombre claro y un precio.',
      'Sube fotos reales de tu producto (mira los consejos abajo).',
      'Guarda y publica. Tu producto aparece en el sitio de inmediato.',
    ],
  },
  {
    icon: '🔗',
    title: 'Comparte tu enlace y tu QR',
    body: [
      'En el panel encontrarás el enlace de tu tienda y un código QR.',
      'Mándalo por WhatsApp a tus contactos, ponlo en tu estado y en tus redes, o imprime el QR y pégalo en tu local.',
    ],
  },
  {
    icon: '💬',
    title: 'Responde rápido por WhatsApp',
    body: [
      'Cuando alguien te escriba, el mensaje ya dice qué publicación le interesó.',
      'Contesta pronto y con amabilidad: quien recibe respuesta rápida casi siempre compra.',
      'Acuerda precio, entrega y forma de pago directo con tu cliente. Aquí no cobramos comisión.',
    ],
  },
];

const fotos = [
  { icon: '☀️', t: 'Luz natural', d: 'Toma la foto cerca de una ventana o a la sombra en el día. Evita el flash.' },
  { icon: '🧼', t: 'Fondo limpio', d: 'Usa una mesa, pared o tela lisa. Quita lo que no sea parte del producto.' },
  { icon: '🔲', t: 'Cuadrada u horizontal', d: 'Se ven mejor completas en el sitio. Evita fotos muy alargadas.' },
  { icon: '🖼️', t: 'De 3 a 4 fotos', d: 'Una de frente, una de cerca (detalle) y una en uso o con tamaño de referencia. Puedes subir hasta 4.' },
  { icon: '🏷️', t: 'Precio claro', d: 'Escribe el precio real. Si varía por tamaño, dilo en la descripción.' },
];

const faqs = [
  { q: '¿Tiene costo publicar?', a: 'No. Crear tu negocio y publicar es gratis.' },
  { q: '¿Necesito local para publicar?', a: 'No. Puedes vender desde casa o hacer entregas. El pin en el mapa es opcional y solo sirve si tienes local al que la gente pueda ir.' },
  { q: '¿Mi número de WhatsApp se ve en el sitio?', a: 'No se muestra a cualquiera. El cliente pulsa el botón de WhatsApp y se abre la conversación contigo.' },
  { q: '¿Cuántas fotos puedo subir?', a: 'Hasta 4 por publicación (la primera es la portada). Recomendamos al menos 3 para que el cliente vea bien lo que ofreces. En esta primera versión cada negocio puede tener hasta 12 publicaciones.' },
  { q: '¿Puedo editar o quitar un producto?', a: 'Sí, cuando quieras desde "Publicaciones" en tu panel. Puedes cambiar el precio, las fotos o pausarlo si se te acabó.' },
  { q: '¿Cómo sé si me están viendo?', a: 'En la pestaña "Estadísticas" de tu panel ves las visitas y los clics a WhatsApp de los últimos 30 días.' },
  { q: '¿Qué hago si alguien me escribe y no compra?', a: 'Es normal. Responde con amabilidad y deja la puerta abierta. Muchas personas compran días después.' },
  { q: '¿Puedo pedir ayuda?', a: 'Sí. Escríbenos y te acompañamos con tu primera publicación.' },
];
---
<Base title="Guía rápida para emprendedores" description="Aprende en minutos a publicar tu negocio gratis: crea tu cuenta, sube tus productos con buenas fotos, comparte tu QR y vende por WhatsApp.">
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-extrabold">Guía rápida para emprendedores</h1>
    <p class="mt-3 text-lg text-muted">Publica tu negocio gratis en unos 10 minutos. Solo necesitas tu celular, tu número de WhatsApp y unas fotos de tus productos.</p>
    <div class="mt-5 flex flex-wrap gap-2">
      <a data-cta href="/registro" class="btn btn-primary">Crear mi cuenta gratis</a>
      <a href="/como-funciona" class="btn btn-ghost">Preguntas frecuentes</a>
    </div>

    <ol class="mt-10 space-y-5">
      {pasos.map((p, i) => (
        <li class="card flex gap-4 p-5">
          <div class="flex shrink-0 flex-col items-center gap-1">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-brand-50 text-2xl" role="img" aria-label={p.title}>{p.icon}</span>
            <span class="text-xs font-bold text-brand-700">Paso {i + 1}</span>
          </div>
          <div>
            <h2 class="text-lg font-bold">{p.title}</h2>
            <ul class="mt-2 list-disc space-y-1.5 pl-5 text-muted">
              {p.body.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>

    <section class="mt-12" aria-labelledby="fotos-title">
      <h2 id="fotos-title" class="text-2xl font-bold">Cómo tomar buenas fotos</h2>
      <p class="mt-2 text-muted">Las publicaciones con buenas fotos reciben más mensajes. No necesitas cámara profesional: con tu celular basta.</p>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        {fotos.map((f) => (
          <div class="card flex gap-3 p-4">
            <span class="text-2xl" role="img" aria-label={f.t}>{f.icon}</span>
            <div>
              <h3 class="font-semibold">{f.t}</h3>
              <p class="mt-1 text-sm text-muted">{f.d}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-12" aria-labelledby="faq-title">
      <h2 id="faq-title" class="text-2xl font-bold">Preguntas frecuentes del emprendedor</h2>
      <div class="mt-4 space-y-3">
        {faqs.map((i) => (
          <details class="group card px-4 py-3">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-semibold focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-500">
              {i.q}
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 transition-transform group-open:rotate-180"><path d="M6 9l6 6 6-6" /></svg>
            </summary>
            <p class="mt-2 text-muted">{i.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="my-12 card flex flex-col items-start gap-4 bg-brand-900 p-8 text-white sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-xl font-bold">¿Listo para publicar?</h2>
        <p class="mt-1 text-brand-100">Es gratis y toma pocos minutos.</p>
      </div>
      <a data-cta href="/registro" class="btn bg-white text-brand-900 hover:bg-brand-50">Publicar mi negocio</a>
    </section>
  </div>
</Base>
