---
import Base from '../layouts/Base.astro';
---
<Base title="Algo salió mal" noindex>
  <section class="mx-auto max-w-xl px-4 py-16 text-center">
    <p class="text-5xl font-extrabold text-brand-600">500</p>
    <h1 class="mt-3 text-2xl font-bold">Algo salió mal de nuestro lado</h1>
    <p class="mt-2 text-muted">Tuvimos un problema al cargar esta página. Intenta de nuevo en unos minutos.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm">
      <a href="/" class="btn btn-primary">Ir al inicio</a>
      <a href="/explorar" class="btn btn-ghost">Explorar</a>
    </div>
  </section>
</Base>
