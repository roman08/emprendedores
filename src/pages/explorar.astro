---
import Base from '../layouts/Base.astro';
import ListingCard from '../components/ListingCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { supabase } from '../lib/supabase';

const sp = Astro.url.searchParams;
// Sin caracteres de control, espacios colapsados y máximo 80 caracteres
const q = (sp.get('q') ?? '').replace(/[\u0000-\u001f\u007f-\u009f]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 80);
const categoria = sp.get('categoria') ?? '';
const municipio = sp.get('municipio') ?? '';
const tipo = sp.get('tipo') ?? '';
const pageNum = Math.floor(Number(sp.get('pagina') ?? 1));
let page = Number.isFinite(pageNum) ? Math.min(Math.max(1, pageNum), 500) : 1;
const PAGE_SIZE = 24;

const [{ data: categories }, { data: municipalities }] = await Promise.all([
  supabase.from('categories').select('id,name,slug').order('sort'),
  supabase.from('municipalities').select('id,name,slug,lat,lng').order('name'),
]);

const cat = categories?.find((c) => c.slug === categoria);
const mun = municipalities?.find((m) => m.slug === municipio);

const type = tipo === 'product' || tipo === 'service' ? tipo : null;
const SELECT = 'id,slug,title,price,type,availability,listing_images(url,position),businesses!inner(name,municipality_id,municipalities(name))';

// Orden por cercanía (por defecto). Origen: el municipio elegido en "Desde" o la ubicación aproximada
// que el navegador guardó en la cookie "ubi" (lat,lng con 3 decimales, 24 h) cuando la persona pulsó "Usar mi ubicación".
const orden = sp.get('orden') === 'relevancia' ? 'relevancia' : 'cerca';
const desde = sp.get('desde') ?? '';
const desdeMun = municipalities?.find((m) => m.slug === desde);
const ubi = /^(-?\d{1,3}(?:\.\d{1,4})?),(-?\d{1,3}(?:\.\d{1,4})?)$/.exec(Astro.cookies.get('ubi')?.value ?? '');
let origin: { lat: number; lng: number; label: string } | null = null;
if (desdeMun && desdeMun.lat !== null && desdeMun.lng !== null) {
  origin = { lat: desdeMun.lat, lng: desdeMun.lng, label: `el centro de ${desdeMun.name}` };
} else if (ubi && Math.abs(Number(ubi[1])) <= 90 && Math.abs(Number(ubi[2])) <= 180) {
  origin = { lat: Number(ubi[1]), lng: Number(ubi[2]), label: 'tu ubicación' };
}
const needsLocation = orden === 'cerca' && origin === null;
let nearOk = false;

// Búsqueda por RPC (sin acentos, tolerante a errores); devuelve ids ordenados y total.
// Con origen, la ordena de la más cercana a la más lejana (search_listings_near); si esa función aún no existe, usa la de relevancia.
async function search(p: number) {
  const base = {
    p_q: q || null,
    p_category: cat?.id ?? null,
    p_municipality: mun?.id ?? null,
    p_type: type,
    p_limit: PAGE_SIZE,
    p_offset: (p - 1) * PAGE_SIZE,
  };
  if (orden === 'cerca' && origin) {
    const r = await supabase.rpc('search_listings_near', { ...base, p_lat: origin.lat, p_lng: origin.lng });
    if (!r.error) { nearOk = true; return r; }
  }
  nearOk = false;
  return supabase.rpc('search_listings', base);
}

let { data: hits, error: rpcError } = await search(page);
// Página fuera de rango: vuelve a la primera
if (!rpcError && (hits ?? []).length === 0 && page > 1) {
  page = 1;
  ({ data: hits, error: rpcError } = await search(1));
}

let listings: any[] = [];
let count = 0;

if (!rpcError) {
  const rows = (hits ?? []) as { listing_id: string; total: number; distance_km?: number | null; exact?: boolean }[];
  count = Number(rows[0]?.total ?? 0);
  if (rows.length) {
    const { data } = await supabase.from('listings').select(SELECT).in('id', rows.map((r) => r.listing_id));
    const byId = new Map((data ?? []).map((l: any) => [l.id, l]));
    listings = rows
      .map((r) => {
        const l = byId.get(r.listing_id);
        return l ? { ...l, distance_km: r.distance_km ?? null, distance_exact: r.exact ?? false } : null;
      })
      .filter(Boolean);
  }
} else {
  // Respaldo si la función aún no existe en la base: búsqueda simple por título
  let fb = supabase
    .from('listings')
    .select(SELECT, { count: 'exact' })
    .eq('status', 'published')
    .order('featured_until', { ascending: false, nullsFirst: false })
    .order('created_at', { ascending: false })
    .range((page - 1) * PAGE_SIZE, page * PAGE_SIZE - 1);
  if (q) fb = fb.ilike('title', `%${q.replace(/[%,()\\]/g, ' ')}%`);
  if (cat) fb = fb.eq('category_id', cat.id);
  if (mun) fb = fb.eq('businesses.municipality_id', mun.id);
  if (type) fb = fb.eq('type', type);
  const res = await fb;
  listings = res.data ?? [];
  count = res.count ?? 0;
}

const totalPages = Math.max(1, Math.ceil(count / PAGE_SIZE));
const hasFilters = Boolean(cat || mun || type);

// "¿Quisiste decir…?" solo cuando no hay resultados
let suggestion: string | null = null;
if (count === 0 && q && !rpcError) {
  const { data: s } = await supabase.rpc('suggest_search', { p_q: q });
  if (typeof s === 'string' && s) suggestion = s;
}

function searchUrl(params: Record<string, string>) {
  const u = new URLSearchParams();
  for (const [k, v] of Object.entries(params)) if (v) u.set(k, v);
  const s = u.toString();
  return '/explorar' + (s ? `?${s}` : '');
}

function pageUrl(p: number) {
  const u = new URL(Astro.url);
  u.searchParams.set('pagina', String(p));
  return u.pathname + u.search;
}
---
<Base title="Explorar" description="Busca productos y servicios de emprendedores locales.">
  <div class="mx-auto max-w-6xl px-4 py-8">
    <h1 class="text-2xl font-bold">
      {q ? `Resultados para “${q}”` : cat ? cat.name : 'Explorar'}
      {mun && <span class="text-muted"> en {mun.name}</span>}
    </h1>

    <form class="card mt-5 grid gap-3 p-4 sm:grid-cols-2 lg:grid-cols-5">
      <input name="q" value={q} class="input lg:col-span-2" placeholder="Buscar…" aria-label="Buscar" />
      <select name="categoria" class="input" aria-label="Categoría">
        <option value="">Todas las categorías</option>
        {categories?.map((c) => <option value={c.slug} selected={c.slug === categoria}>{c.name}</option>)}
      </select>
      <select name="municipio" class="input" aria-label="Municipio">
        <option value="">Todo Tabasco</option>
        {municipalities?.map((m) => <option value={m.slug} selected={m.slug === municipio}>{m.name}</option>)}
      </select>
      <div class="flex gap-2">
        <select name="tipo" class="input" aria-label="Tipo">
          <option value="">Todo</option>
          <option value="product" selected={tipo === 'product'}>Productos</option>
          <option value="service" selected={tipo === 'service'}>Servicios</option>
        </select>
        <button class="btn btn-primary">Filtrar</button>
      </div>
      <div class="flex flex-wrap items-center gap-3 border-t border-line pt-3 sm:col-span-2 lg:col-span-5">
        <label class="flex items-center gap-2 text-sm">
          <span class="font-medium">Ordenar</span>
          <select name="orden" class="input !w-auto" id="orden-select">
            <option value="cerca" selected={orden === 'cerca'}>Más cercanos primero</option>
            <option value="relevancia" selected={orden === 'relevancia'}>Más relevantes</option>
          </select>
        </label>
        <label class="flex items-center gap-2 text-sm">
          <span class="font-medium">Desde</span>
          <select name="desde" class="input !w-auto" id="desde-select">
            <option value="">Mi ubicación</option>
            {municipalities?.filter((m) => m.lat !== null).map((m) => <option value={m.slug} selected={m.slug === desde}>Centro de {m.name}</option>)}
          </select>
        </label>
        {origin && ubi && !desdeMun && (
          <button type="button" data-clear-location class="text-sm text-muted underline hover:text-ink">Olvidar mi ubicación</button>
        )}
      </div>
    </form>

    {needsLocation && (
      <div class="mt-3 flex flex-wrap items-center gap-3 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-900">
        <span>Para ordenar del más cercano al más lejano necesitamos tu ubicación (no se guarda en nuestros servidores) o elige un punto en «Desde».</span>
        <button type="button" data-use-location class="btn btn-outline !py-1.5">Usar mi ubicación</button>
        <span id="loc-msg" role="status" class="text-amber-800"></span>
      </div>
    )}
    {nearOk && origin && (
      <p class="mt-3 text-sm text-muted">Ordenados del más cercano al más lejano desde {origin.label}.</p>
    )}

    {mun && (
      <p class="mt-3 text-sm">
        <a class="font-semibold text-brand-700 hover:underline" href={`/tabasco/${mun.slug}${cat ? `/${cat.slug}` : ''}`}>
          Ver {cat ? `${cat.name} en ` : 'todo en '}{mun.name} →
        </a>
      </p>
    )}

    <AdSlot slot="top" class="mt-6" />

    {listings.length === 0 ? (
      <div class="card mt-6 p-8 text-center">
        <p class="font-semibold">No encontramos resultados.</p>
        {suggestion && (
          <p class="mt-2 text-sm">
            ¿Quisiste decir{' '}
            <a class="font-semibold text-brand-700 underline" href={searchUrl({ q: suggestion, categoria, municipio, tipo })}>{suggestion}</a>?
          </p>
        )}
        <p class="mt-2 text-sm text-muted">Revisa la ortografía o prueba con palabras más generales.</p>
        {hasFilters && (
          <a class="btn btn-outline mt-4" href={searchUrl({ q })}>Quitar filtros</a>
        )}
        {(categories ?? []).length > 0 && (
          <div class="mt-6">
            <p class="text-sm text-muted">O explora por categoría:</p>
            <div class="mt-3 flex flex-wrap justify-center gap-2">
              {(categories ?? []).slice(0, 8).map((c) => (
                <a class="btn btn-ghost" href={searchUrl({ categoria: c.slug })}>{c.name}</a>
              ))}
            </div>
          </div>
        )}
      </div>
    ) : (
      <>
        <p class="mt-6 text-sm text-muted" aria-live="polite">
          {count === 1 ? '1 resultado' : `${count} resultados`}
        </p>
        <div class="mt-3 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
          {listings.map((l) => <ListingCard l={l} />)}
        </div>
      </>
    )}

    {totalPages > 1 && (
      <nav class="mt-8 flex items-center justify-center gap-3" aria-label="Paginación">
        {page > 1 && <a class="btn btn-ghost" href={pageUrl(page - 1)}>← Anterior</a>}
        <span class="text-sm text-muted">Página {page} de {totalPages}</span>
        {page < totalPages && <a class="btn btn-ghost" href={pageUrl(page + 1)}>Siguiente →</a>}
      </nav>
    )}
  </div>
</Base>

<script>
  // Ubicación aproximada para ordenar por cercanía: se guarda solo en una cookie del navegador (24 h, 3 decimales ≈ 100 m).
  const hasCookie = () => document.cookie.split('; ').some((c) => c.startsWith('ubi='));
  const secure = location.protocol === 'https:' ? '; secure' : '';

  function ask(): Promise<boolean> {
    return new Promise((resolve) => {
      if (!('geolocation' in navigator)) return resolve(false);
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const v = `${pos.coords.latitude.toFixed(3)},${pos.coords.longitude.toFixed(3)}`;
          document.cookie = `ubi=${v}; max-age=86400; path=/; samesite=lax${secure}`;
          resolve(true);
        },
        () => resolve(false),
        { enableHighAccuracy: false, timeout: 10000, maximumAge: 60000 },
      );
    });
  }

  // Botón del aviso: pide la ubicación y recarga con los mismos filtros
  document.querySelector<HTMLButtonElement>('[data-use-location]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    btn.disabled = true;
    const ok = await ask();
    if (ok) return location.reload();
    btn.disabled = false;
    const msg = document.getElementById('loc-msg');
    if (msg) msg.textContent = 'No pudimos obtener tu ubicación. Elige un punto en «Desde».';
  });

  document.querySelector('[data-clear-location]')?.addEventListener('click', () => {
    document.cookie = 'ubi=; max-age=0; path=/; samesite=lax';
    location.reload();
  });

  // Al buscar con "Más cercanos" y sin punto de partida, pide la ubicación antes de enviar el formulario
  const form = document.getElementById('orden-select')?.closest('form');
  form?.addEventListener('submit', async (e) => {
    const orden = (document.getElementById('orden-select') as HTMLSelectElement).value;
    const desde = (document.getElementById('desde-select') as HTMLSelectElement).value;
    if (orden !== 'cerca' || desde || hasCookie()) return;
    e.preventDefault();
    await ask(); // si la rechaza, el servidor mostrará el aviso con alternativas
    form.submit();
  });
</script>
