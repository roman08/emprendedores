---
import Base from '../layouts/Base.astro';
Astro.response.status = 404;
---
<Base title="Página no encontrada" noindex>
  <section class="mx-auto max-w-xl px-4 py-16 text-center">
    <p class="text-5xl font-extrabold text-brand-600">404</p>
    <h1 class="mt-3 text-2xl font-bold">No encontramos esta página</h1>
    <p class="mt-2 text-muted">Puede que el enlace esté mal escrito o que la publicación ya no esté disponible.</p>
    <form action="/explorar" class="mt-8 flex gap-2">
      <input name="q" class="input !py-3" placeholder="Busca productos o servicios…" aria-label="Buscar" />
      <button class="btn btn-primary">Buscar</button>
    </form>
    <div class="mt-6 flex flex-wrap justify-center gap-3 text-sm">
      <a href="/" class="btn btn-ghost">Ir al inicio</a>
      <a href="/explorar" class="btn btn-ghost">Explorar todo</a>
      <a href="/como-funciona" class="btn btn-ghost">Cómo funciona</a>
    </div>
  </section>
</Base>
