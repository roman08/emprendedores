---
import Base from '../../layouts/Base.astro';
import ListingCard from '../../components/ListingCard.astro';
import MapView from '../../components/MapView';
import ReportButton from '../../components/ReportButton';
import ShareButtons from '../../components/ShareButtons';
import ReviewsSection from '../../components/ReviewsSection';
import FavoriteButton from '../../components/FavoriteButton';
import { supabase } from '../../lib/supabase';
import { BRAND } from '../../lib/brand';
import { mapsLink, initials, safeHttpUrl, ldJson, cssUrl } from '../../lib/format';
import HoursList from '../../components/HoursList.astro';
import ClosedDialog from '../../components/ClosedDialog.astro';
import VerifiedBadge from '../../components/VerifiedBadge.astro';
import { DAYS, parseHours, openStatus, shiftsOf } from '../../lib/hours';

const { slug } = Astro.params;
const { data: b } = await supabase
  .from('businesses')
  .select('*, municipalities(name)')
  .eq('slug', slug!)
  .eq('status', 'active')
  .maybeSingle();

if (!b) return Astro.rewrite('/404');

const { data: listings } = await supabase
  .from('listings')
  .select('id,slug,title,price,type,availability,listing_images(url,position),businesses(name,municipalities(name))')
  .eq('business_id', b.id)
  .eq('status', 'published')
  .order('created_at', { ascending: false });

// Calificación pública (solo reseñas visibles); si la migración 0014 aún no existe, simplemente no se muestra
const { data: ratingRows } = await supabase.rpc('business_rating_summary', { p_business: b.id });
const rating = ratingRows?.[0] && ratingRows[0].review_count > 0 && ratingRows[0].avg_rating !== null
  ? { avg: Number(ratingRows[0].avg_rating), count: Number(ratingRows[0].review_count) }
  : null;

// El número no se imprime en el HTML: /ir/whatsapp registra el clic en el servidor y redirige a wa.me
const wa = `/ir/whatsapp/tienda?negocio=${b.id}`;
const maps = mapsLink(b) ? `/ir/mapa/tienda?negocio=${b.id}` : null;
const hours = parseHours(b.hours);
const status = openStatus(hours);
// Los enlaces los escribe el dueño: solo se publican si son http(s)
const facebookUrl = safeHttpUrl(b.facebook);
const websiteUrl = safeHttpUrl(b.website);
const bannerCss = cssUrl(b.banner_url);
const igHandle =(b.instagram ?? '').trim().replace(/^https?:\/\/(www\.)?instagram\.com\//i, '').replace(/^@/, '').replace(/[/?#].*$/, '');

const SCHEMA_DAY: Record<string, string> = { mon: 'Monday', tue: 'Tuesday', wed: 'Wednesday', thu: 'Thursday', fri: 'Friday', sat: 'Saturday', sun: 'Sunday' };
const openingHoursSpecification = hours
  ? DAYS.flatMap(({ key }) => shiftsOf(hours[key]).map((s) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: SCHEMA_DAY[key],
      opens: s.open,
      closes: s.close,
    })))
  : [];
// Sin teléfono a propósito: el número de WhatsApp no se publica en el marcado.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: b.name,
  description: b.description ?? undefined,
  url: Astro.url.href,
  image: b.banner_url ?? b.logo_url ?? undefined,
  ...(b.has_physical_store && b.address_text && {
    address: { '@type': 'PostalAddress', streetAddress: b.address_text, addressLocality: b.municipalities?.name, addressRegion: 'Tabasco', addressCountry: 'MX' },
  }),
  ...(b.has_physical_store && b.lat !== null && b.lng !== null && { geo: { '@type': 'GeoCoordinates', latitude: b.lat, longitude: b.lng } }),
  ...(openingHoursSpecification.length > 0 && { openingHoursSpecification }),
  ...(rating && { aggregateRating: { '@type': 'AggregateRating', ratingValue: rating.avg, reviewCount: rating.count, bestRating: 5, worstRating: 1 } }),
};
---
<Base title={b.name} description={b.description?.slice(0, 155) ?? `Conoce a ${b.name}`} image={b.banner_url ?? b.logo_url ?? undefined}>
  <script type="application/ld+json" slot="head" set:html={ldJson(jsonLd)} />
  <div class="h-40 bg-gradient-to-r from-brand-700 to-brand-500 sm:h-56"
       style={bannerCss ? `background:${bannerCss} center/cover` : ''}></div>
  <div class="mx-auto max-w-6xl px-4">
    <div class="-mt-12 flex flex-col gap-4 sm:flex-row sm:items-end">
      {b.logo_url
        ? <img src={b.logo_url} alt="" class="h-24 w-24 rounded-2xl border-4 border-white bg-white object-cover shadow" />
        : <span class="grid h-24 w-24 place-items-center rounded-2xl border-4 border-white bg-brand-100 text-3xl font-bold text-brand-700 shadow">{initials(b.name)}</span>}
      <div class="flex-1 pb-1">
        <h1 class="text-2xl font-extrabold">{b.name}{b.verified && <VerifiedBadge size={24} class="ml-2" />}</h1>
        <p class="text-sm text-muted">{b.municipalities?.name ?? 'Tabasco'}</p>
        {rating && (
          <a href="#resenas" class="mt-0.5 inline-flex items-center gap-1.5 text-sm hover:underline" aria-label={`Calificación ${rating.avg.toFixed(1).replace('.', ',')} de 5, ${rating.count} ${rating.count === 1 ? 'reseña' : 'reseñas'}. Ver reseñas`}>
            <span class="text-accent" aria-hidden="true">★</span>
            <span class="font-semibold" aria-hidden="true">{rating.avg.toFixed(1).replace('.', ',')}</span>
            <span class="text-muted" aria-hidden="true">({rating.count})</span>
          </a>
        )}
        {status && (
          <p class={`mt-1 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ${status.open ? 'bg-brand-50 text-brand-700' : 'bg-surface text-muted'}`}>
            <span class={`h-2 w-2 rounded-full ${status.open ? 'bg-brand-500' : 'bg-gray-400'}`}></span>{status.label}
          </p>
        )}
      </div>
      <FavoriteButton client:idle kind="business" id={b.id} label="Guardar negocio" />
      <a href={wa} target="_blank" rel="noopener" data-wa-closed={status && !status.open ? status.label : undefined} class="btn btn-wa">Escribir por WhatsApp</a>
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_340px]">
      <div>
        {b.description && <p class="whitespace-pre-line text-muted">{b.description}</p>}
        <div class="mt-4"><ShareButtons client:idle title={`${b.name} en ${BRAND.name}`} /></div>
        <h2 class="mt-8 text-lg font-bold">Publicaciones ({listings?.length ?? 0})</h2>
        {(listings ?? []).length === 0
          ? <p class="mt-3 text-muted">Este negocio aún no tiene publicaciones.</p>
          : <div class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-3">{(listings ?? []).map((l) => <ListingCard l={l} />)}</div>}
        <ReviewsSection client:visible businessId={b.id} />
      </div>
      <aside class="space-y-4">
        {b.has_physical_store && (b.address_text || b.lat !== null) && (
          <div class="card p-4">
            <p class="mb-1 text-sm font-semibold">Dónde estamos</p>
            {b.address_text && <p class="mb-3 text-sm text-muted">{b.address_text}</p>}
            {b.lat !== null && <MapView client:visible lat={b.lat} lng={b.lng} label={b.name} height={220} />}
            {maps && <a href={maps} target="_blank" rel="noopener" class="btn btn-ghost mt-3 w-full">Cómo llegar</a>}
          </div>
        )}
        {hours && (
          <div class="card p-4">
            <p class="mb-3 text-sm font-semibold">Horarios</p>
            <HoursList hours={hours} todayKey={status?.todayKey} />
          </div>
        )}
        {(igHandle || facebookUrl || websiteUrl) && (
          <div class="card space-y-2 p-4 text-sm">
            <p class="font-semibold">Redes</p>
            {igHandle && <a class="block text-brand-700 hover:underline" href={`https://instagram.com/${encodeURIComponent(igHandle)}`} target="_blank" rel="noopener nofollow">Instagram</a>}
            {facebookUrl && <a class="block text-brand-700 hover:underline" href={facebookUrl} target="_blank" rel="noopener nofollow">Facebook</a>}
            {websiteUrl && <a class="block text-brand-700 hover:underline" href={websiteUrl} target="_blank" rel="noopener nofollow">Sitio web</a>}
          </div>
        )}
        <div class="text-center"><ReportButton client:visible businessId={b.id} label="Reportar este negocio" /></div>
      </aside>
    </div>
  </div>
  <div class="h-8"></div>
  {status && !status.open && <ClosedDialog />}
</Base>
