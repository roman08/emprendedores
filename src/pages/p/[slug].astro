---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import MapView from '../../components/MapView';
import ReportButton from '../../components/ReportButton';
import ShareButtons from '../../components/ShareButtons';
import FavoriteButton from '../../components/FavoriteButton';
import ListingCard from '../../components/ListingCard.astro';
import { BRAND } from '../../lib/brand';
import { supabase } from '../../lib/supabase';
import { formatPrice, mapsLink, initials, ldJson } from '../../lib/format';
import HoursList from '../../components/HoursList.astro';
import ClosedDialog from '../../components/ClosedDialog.astro';
import VerifiedBadge from '../../components/VerifiedBadge.astro';
import { DAYS, parseHours, openStatus, shiftsOf } from '../../lib/hours';

const { slug } = Astro.params;
const { data: l } = await supabase
  .from('listings')
  .select('*, listing_images(url,position), categories(name,slug), businesses(*, municipalities(name))')
  .eq('slug', slug!)
  .eq('status', 'published')
  .maybeSingle();

if (!l) return Astro.rewrite('/404');

const images = [...l.listing_images].sort((a: any, b: any) => a.position - b.position);
const b = l.businesses;
const soldOut = l.availability === 'sold_out';
// El número no se imprime en el HTML: /ir/whatsapp registra el clic en el servidor y redirige a wa.me
const wa = `/ir/whatsapp/${l.id}`;
const maps = mapsLink(b) ? `/ir/mapa/${l.id}` : null;
const hours = parseHours(b.hours);
const status = openStatus(hours);
const SCHEMA_DAY: Record<string, string> = { mon: 'Monday', tue: 'Tuesday', wed: 'Wednesday', thu: 'Thursday', fri: 'Friday', sat: 'Saturday', sun: 'Sunday' };
const openingHoursSpecification = hours
  ? DAYS.flatMap(({ key }) => shiftsOf(hours[key]).map((s) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: SCHEMA_DAY[key],
      opens: s.open,
      closes: s.close,
    })))
  : [];
const desc = (l.description ?? '').slice(0, 155) || `${l.title} de ${b.name}`;

// Relacionados: consultas ligeras; los bloques vacíos se omiten.
const REL_SELECT = 'id,slug,title,price,type,availability,listing_images(url,position),businesses(name,municipality_id,municipalities(name))';
const [{ data: moreRaw }, { data: similarRaw }] = await Promise.all([
  supabase.from('listings').select(REL_SELECT).eq('business_id', b.id).eq('status', 'published').neq('id', l.id).order('created_at', { ascending: false }).limit(4),
  l.category_id
    ? supabase.from('listings').select(REL_SELECT).eq('category_id', l.category_id).eq('status', 'published').neq('business_id', b.id).order('created_at', { ascending: false }).limit(16)
    : Promise.resolve({ data: [] as any[] }),
]);
const moreFromBusiness = moreRaw ?? [];
// Mismo municipio primero (el sort es estable, conserva el orden por fecha).
const similar = [...(similarRaw ?? [])]
  .sort((x: any, y: any) => Number(y.businesses?.municipality_id === b.municipality_id) - Number(x.businesses?.municipality_id === b.municipality_id))
  .slice(0, 4);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: l.title,
  description: l.description ?? undefined,
  image: images.map((i: any) => i.url),
  ...(l.price !== null && { offers: { '@type': 'Offer', price: l.price, priceCurrency: 'MXN' } }),
};
// Negocio vendedor con su horario (sin teléfono: el número no se publica).
const sellerLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: b.name,
  url: new URL(`/n/${b.slug}`, Astro.url).href,
  ...(openingHoursSpecification.length > 0 && { openingHoursSpecification }),
};
---
<Base title={l.title} description={desc} image={images[0]?.url}>
  <script type="application/ld+json" slot="head" set:html={ldJson(jsonLd)} />
  {hours && <script type="application/ld+json" slot="head" set:html={ldJson(sellerLd)} />}
  <div class="mx-auto max-w-6xl px-4 py-8" data-listing={l.id} data-business={b.id}>
    <nav class="mb-4 text-sm text-muted">
      <a href="/explorar" class="hover:text-ink">Explorar</a>
      {l.categories && <> / <a href={`/explorar?categoria=${l.categories.slug}`} class="hover:text-ink">{l.categories.name}</a></>}
    </nav>

    <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <div class="card overflow-hidden"><img id="main-img" src={images[0]?.url} alt={l.title} fetchpriority="high" decoding="async" class:list={['aspect-[4/3] w-full object-cover', soldOut && 'opacity-50 grayscale']} /></div>
        {images.length > 1 && (
          <div class="mt-3 flex gap-2 overflow-x-auto">
            {images.map((i: any) => (
              <button type="button" data-thumb={i.url} class="h-20 w-24 shrink-0 overflow-hidden rounded-xl border border-line">
                <img src={i.url} alt="" class="h-full w-full object-cover" loading="lazy" />
              </button>
            ))}
          </div>
        )}
        {l.description && (
          <section class="mt-8">
            <h2 class="text-lg font-bold">Descripción</h2>
            <p class="mt-2 whitespace-pre-line text-muted">{l.description}</p>
          </section>
        )}
      </div>

      <aside class="space-y-4">
        <div class="card p-6">
          <span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700">{l.type === 'service' ? 'Servicio' : 'Producto'}</span>
          {soldOut && <span class="ml-2 rounded-full bg-gray-900 px-2.5 py-1 text-xs font-semibold text-white">Agotado</span>}
          {l.availability === 'on_demand' && <span class="ml-2 rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-800">Sobre pedido</span>}
          <div class="mt-3 flex items-start justify-between gap-3">
            <h1 class="text-2xl font-bold leading-tight">{l.title}</h1>
            <FavoriteButton client:idle kind="listing" id={l.id} className="shrink-0" />
          </div>
          <p class="mt-2 text-3xl font-extrabold text-brand-700">{formatPrice(l.price)}</p>
          <a id="wa" href={wa} target="_blank" rel="noopener" data-wa-closed={status && !status.open ? status.label : undefined} class="btn btn-wa mt-5 w-full !py-3.5 text-base">{soldOut ? 'Preguntar cuándo habrá' : 'Contactar por WhatsApp'}</a>
          {status && !status.open && (
            <p class="mt-3 rounded-xl bg-amber-50 px-3 py-2 text-center text-xs text-amber-800">
              Fuera de horario ({status.label.replace('Cerrado · ', '')}). Es posible que tarden en responder.
            </p>
          )}
          <p class="mt-3 text-center text-xs text-muted">Acuerda precio, entrega y pago directamente con el vendedor.</p>
          <div class="mt-4 border-t border-line pt-4"><ShareButtons client:idle title={`${l.title} en ${BRAND.name}`} /></div>
        </div>

        <div class="card p-4">
          <div class="flex items-center gap-4">
            {b.logo_url
              ? <img src={b.logo_url} alt="" class="h-14 w-14 rounded-xl object-cover" />
              : <span class="grid h-14 w-14 place-items-center rounded-xl bg-brand-100 text-lg font-bold text-brand-700">{initials(b.name)}</span>}
            <div class="min-w-0 flex-1">
              <p class="truncate font-semibold">{b.name}{b.verified && <VerifiedBadge size={18} class="ml-1" />}</p>
              <p class="text-sm text-muted">{b.municipalities?.name ?? 'Tabasco'}</p>
              {status && (
                <p class={`mt-0.5 flex items-center gap-1.5 text-xs font-medium ${status.open ? 'text-brand-700' : 'text-muted'}`}>
                  <span class={`h-2 w-2 rounded-full ${status.open ? 'bg-brand-500' : 'bg-gray-400'}`}></span>{status.label}
                </p>
              )}
            </div>
          </div>
          {hours && (
            <details class="group mt-4 rounded-xl border border-line px-3 py-2">
              <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-500">
                Ver horario
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform group-open:rotate-180"><path d="M6 9l6 6 6-6" /></svg>
              </summary>
              <div class="mt-2 pb-1"><HoursList hours={hours} todayKey={status?.todayKey} /></div>
            </details>
          )}
          <a href={`/n/${b.slug}`} class="btn btn-outline mt-4 w-full">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9l1.5-5h15L21 9" /><path d="M4 9v11h16V9" /><path d="M9 20v-6h6v6" />
            </svg>
            Ver tienda
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" /><path d="M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>

        {b.has_physical_store && b.lat !== null && (
          <div class="card p-4">
            <p class="mb-2 text-sm font-semibold">Visítanos</p>
            {b.address_text && <p class="mb-3 text-sm text-muted">{b.address_text}</p>}
            <MapView client:visible lat={b.lat} lng={b.lng} label={b.name} height={200} />
            {maps && <a id="map" href={maps} target="_blank" rel="noopener" class="btn btn-ghost mt-3 w-full">Cómo llegar</a>}
          </div>
        )}
        <div class="text-center"><ReportButton client:visible listingId={l.id} label="Reportar esta publicación" /></div>
        <AdSlot slot="side" />
      </aside>
    </div>

    {moreFromBusiness.length > 0 && (
      <section class="mt-12">
        <h2 class="text-lg font-bold">Más de {b.name}</h2>
        <div class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-4">{moreFromBusiness.map((x: any) => <ListingCard l={x} />)}</div>
      </section>
    )}
    {similar.length > 0 && (
      <section class="mt-12">
        <h2 class="text-lg font-bold">Productos similares</h2>
        <div class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-4">{similar.map((x: any) => <ListingCard l={x} />)}</div>
      </section>
    )}
  </div>
  {status && !status.open && <ClosedDialog />}
</Base>

<script>
  import { supabase } from '../../lib/supabase';
  const root = document.querySelector<HTMLElement>('[data-listing]')!;
  const listing = root.dataset.listing!;
  // Identificador anónimo del visitante (uuid en localStorage). Si el almacenamiento no está disponible no se cuenta la vista.
  const visitorId = (): string | null => {
    try {
      let v = localStorage.getItem('vid');
      if (!v || v.length < 8) {
        v = crypto.randomUUID();
        localStorage.setItem('vid', v);
      }
      return v;
    } catch {
      return null;
    }
  };

  // Las vistas se deduplican en la base (1 por visitante, publicación y día). Los clics de
  // WhatsApp y mapa se registran en el servidor (/ir/whatsapp y /ir/mapa).
  // rpc() es perezoso: solo envía la petición cuando se consume (.then), por eso se encadena aquí.
  const vid = visitorId();
  if (vid) {
    supabase.rpc('track_event', { p_listing: listing, p_business: null, p_kind: 'view', p_visitor: vid }).then(({ error }) => {
      if (error) console.warn('track_event', error.message);
    });
  }
  document.querySelectorAll<HTMLElement>('[data-thumb]').forEach((el) =>
    el.addEventListener('click', () => {
      (document.getElementById('main-img') as HTMLImageElement).src = el.dataset.thumb!;
    }),
  );
</script>
