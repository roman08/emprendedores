---
import QRCode from 'qrcode';
import Base from '../layouts/Base.astro';
import { BRAND } from '../lib/brand';

const registro = new URL('/registro', Astro.site ?? Astro.url.origin).href;
const display = registro.replace(/^https?:\/\//, '');
const qr = await QRCode.toString(registro, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#0b3b34', light: '#ffffff' } });

const pasos = [
  { n: '1', t: 'Crea tu cuenta', d: 'Con tu correo, en un minuto.' },
  { n: '2', t: 'Registra tu negocio', d: 'Nombre, WhatsApp y tus productos con fotos.' },
  { n: '3', t: 'Recibe clientes', d: 'Te escriben directo a tu WhatsApp.' },
];
---
<Base title="Volante para imprimir" noindex bare description="Volante imprimible para invitar a negocios locales a publicar gratis.">
  <style is:global>
    @page { size: A4 portrait; margin: 0; }
    @media print {
      html, body { background: #fff !important; }
      .no-print, #cookie-consent { display: none !important; }
      .flyer-wrap { padding: 0 !important; background: #fff !important; }
      .flyer { box-shadow: none !important; border-radius: 0 !important; width: 210mm !important; height: 297mm !important; margin: 0 !important; }
      * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  </style>

  <div class="flyer-wrap bg-surface px-4 py-6">
    <div class="no-print mx-auto mb-5 flex max-w-[210mm] flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-muted">Imprímelo en tamaño A4. Para guardarlo como PDF elige "Guardar como PDF" en la impresora.</p>
      <button type="button" id="print-btn" class="btn btn-primary">Imprimir / Guardar PDF</button>
    </div>

    <article class="flyer mx-auto flex w-full max-w-[210mm] flex-col justify-between overflow-hidden bg-white shadow-lg sm:aspect-[210/297]" aria-label="Volante">
      <header class="bg-brand-900 px-10 py-10 text-white">
        <p class="text-lg font-bold tracking-wide text-brand-100">{BRAND.name}</p>
        <h1 class="mt-4 text-4xl font-extrabold leading-tight sm:text-5xl">Vende más desde tu WhatsApp.</h1>
        <p class="mt-3 text-3xl font-extrabold text-accent sm:text-4xl">Publica gratis tu negocio</p>
      </header>

      <ol class="space-y-5 px-10 py-8">
        {pasos.map((p) => (
          <li class="flex items-center gap-5">
            <span class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-brand-600 text-2xl font-extrabold text-white">{p.n}</span>
            <div>
              <p class="text-2xl font-bold text-ink">{p.t}</p>
              <p class="text-lg text-muted">{p.d}</p>
            </div>
          </li>
        ))}
      </ol>

      <footer class="flex flex-col items-center gap-3 border-t border-line bg-brand-50 px-10 py-8 text-center">
        <p class="text-xl font-bold text-brand-900">Escanea y registra tu negocio</p>
        <div class="h-56 w-56 rounded-2xl border border-line bg-white p-2 sm:h-64 sm:w-64" role="img" aria-label={`Código QR que lleva a ${display}`} set:html={qr} />
        <p class="break-all text-lg font-semibold text-brand-700">{display}</p>
        <p class="text-sm text-muted">Gratis · Sin comisiones · Te contactan por WhatsApp</p>
      </footer>
    </article>
  </div>

  <style>
    .flyer :global(svg) { width: 100%; height: 100%; display: block; }
  </style>
  <script>
    document.getElementById('print-btn')?.addEventListener('click', () => window.print());
  </script>
</Base>
