---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import PwaInstall from '../components/PwaInstall.astro';
import { BRAND, pageTitle } from '../lib/brand';

// canonicalPath: ruta (con su ?pagina=N si aplica) para páginas cuya URL canónica no es solo el pathname
interface Props { title?: string; description?: string; image?: string; noindex?: boolean; bare?: boolean; canonicalPath?: string }
const { title, description = BRAND.description, image, noindex = false, bare = false, canonicalPath } = Astro.props;
const fullTitle = pageTitle(title);
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogDefault = new URL('/og-default.png',Astro.site ?? Astro.url.origin).href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={BRAND.themeColor} />
    <!-- App instalable en iPhone/iPad (Safari ignora parte del manifiesto) -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={BRAND.shortName} />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="application-name" content={BRAND.shortName} />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image ?? ogDefault} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Detecta sesión antes del primer render para que el header no parpadee -->
    <script is:inline>
      try {
        var k = Object.keys(localStorage).find(function (x) { return /^sb-.*-auth-token$/.test(x); });
        document.documentElement.dataset.auth = k ? 'in' : 'out';
      } catch (e) { document.documentElement.dataset.auth = 'out'; }
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <div id="nav-progress" aria-hidden="true"></div>
    {!bare && <Header />}
    <main class="flex-1"><slot /></main>
    {!bare && <Footer />}
    <CookieConsent />
    <PwaInstall />
    <script>import '../lib/authUi'; import '../lib/navProgress';</script>
  </body>
</html>
