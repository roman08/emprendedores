PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Opcional: captcha Cloudflare Turnstile en registro, ingreso y recuperación.
# Si la dejas vacía o la quitas, los formularios funcionan sin captcha.
# Debes activar también "Enable CAPTCHA protection" (Turnstile + secret key) en Supabase → Authentication → Attack Protection.
# PUBLIC_TURNSTILE_SITE_KEY=tu-site-key

# Opcional: "1" muestra los espacios publicitarios.
# PUBLIC_ADS=1
# Opcional: Google AdSense (solo se carga tras el consentimiento de publicidad). Requiere PUBLIC_ADS=1.
# PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# PUBLIC_ADSENSE_SLOT=0000000000

# Opcional: analítica Plausible (solo se carga tras el consentimiento de analítica). Pon tu dominio, sin https://.
# PUBLIC_PLAUSIBLE_DOMAIN=tudominio.com

# Opcional: dominio público del sitio (con https://). Hace que sitemap, canonicals y og:image usen el dominio real.
# SITE_URL=https://tudominio.com

# Opcional: geocodificador de direcciones: nominatim (defecto, gratuito) | maptiler | geoapify.
# Si falta la clave del proveedor elegido se usa nominatim. Restringe la clave por dominio en el panel del proveedor.
# PUBLIC_GEOCODER=nominatim
# PUBLIC_MAPTILER_KEY=tu-clave
# PUBLIC_GEOAPIFY_KEY=tu-clave

# Solo servidor (NUNCA con prefijo PUBLIC_ ni en el navegador). En Netlify: Site settings → Environment variables.
# Necesaria para contar los clics de WhatsApp y mapa (rutas /ir/*); sin ella la redirección funciona pero no se cuentan.
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Opcional: cadena aleatoria larga que endurece el identificador anónimo de visitante en /ir/*.
# VISITOR_SALT=cadena-aleatoria-larga
